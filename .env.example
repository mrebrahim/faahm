# ============================================================================
# فاهم! - Environment Variables
# انسخ الملف ده لـ .env.local وعبّي القيم
# 🚨 متضيفش .env.local في Git
# ============================================================================

# ----- Supabase (project_id: jnxtcpicctcnmirjorje) -----
NEXT_PUBLIC_SUPABASE_URL=https://jnxtcpicctcnmirjorje.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=                  # من Supabase → Settings → API
SUPABASE_SERVICE_ROLE_KEY=                       # 🚨 سيرفر فقط

# ----- Stripe -----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_ID_MONTHLY=                         # $9.99/شهر recurring price ID (price_*) — USD default
STRIPE_PRICE_ID_YEARLY=                          # $40/سنة recurring price ID (price_*) — USD default
STRIPE_PRICE_ID_MONTHLY_SAR=                     # 39 ر.س/شهر recurring price ID (price_*) — Saudi funnel
STRIPE_PRICE_ID_YEARLY_SAR=                      # 149 ر.س/سنة recurring price ID (price_*) — Saudi funnel

# ----- Paymob (احتياط) -----
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_WALLET=
PAYMOB_HMAC_SECRET=

# ----- Bunny Stream (video hosting) -----
# Library ID is visible in every embed URL (not a secret). Defaults to 668938
# in code if unset; override here for staging/preview environments.
NEXT_PUBLIC_BUNNY_LIBRARY_ID=668938

# Bunny Token Authentication keys — when set, the embed URL is signed with
# sha256(key + guid + expires) and Bunny rejects requests with a missing
# or wrong token. Blocks hot-linking and direct embed reuse. Per-library
# override (BUNNY_TOKEN_KEY_<id>) takes priority over the default.
# Enable Token Authentication on each Bunny library first, then copy
# its key here. Empty = unsigned URL (no protection).
BUNNY_TOKEN_KEY_DEFAULT=
BUNNY_TOKEN_KEY_668938=
BUNNY_TOKEN_KEY_672644=
BUNNY_TOKEN_KEY_671668=

# ----- Bunny CDN Storage (course thumbnails) -----
# Storage zone that backs public images so we don't pay Supabase egress
# for course covers. Storage → Add Storage Zone in Bunny Dashboard.
BUNNY_STORAGE_ZONE=                              # e.g. faahm-images
BUNNY_STORAGE_ACCESS_KEY=                        # Storage Zone → FTP & API password
BUNNY_STORAGE_REGION=                            # empty=Frankfurt (DE). Use 'ny','la','sg','syd','br' for other regions.
BUNNY_STORAGE_PULLZONE=                          # CDN → Pull Zone hostname, e.g. faahm-images.b-cdn.net

# ----- OpenAI (gpt-4o) — AI quiz generation -----
# Server-only. Create at https://platform.openai.com/api-keys
# Used by /admin/courses/[id]/quizzes/[quizId] "إنشاء أسئلة بالذكاء الاصطناعي".
OPENAI_API_KEY=

# ----- Cloudflare R2 -----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=faahm-assets
NEXT_PUBLIC_R2_PUBLIC_URL=https://assets.faahm.com

# ----- Resend (Emails) -----
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@faahm.com
# Student questions asked from inside a lesson are emailed here, with
# Reply-To set to the student so answering from the inbox reaches them
# directly. Hardcoded as SUPPORT_INBOX in lib/email.ts —
# ibrahim@digitalsolutionegy.com. Without RESEND_API_KEY the question is
# still saved and appears in /admin/questions; only the alert is skipped.

# ----- App -----
NEXT_PUBLIC_APP_URL=http://localhost:3000        # غيّرها لـ https://faahm.com في الإنتاج
NEXT_PUBLIC_SUPPORT_WHATSAPP=201XXXXXXXX

# ----- Analytics & Tracking -----
# GA4 — Measurement ID من Google Analytics → Admin → Data Streams
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Facebook (Meta) — Pixel client-side + Conversions API server-side
NEXT_PUBLIC_FB_PIXEL_ID=
FB_CONVERSIONS_API_TOKEN=

# TikTok — Pixel client-side + Events API server-side
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
TIKTOK_EVENTS_API_TOKEN=

# Microsoft Clarity — heatmaps + session recordings
# From clarity.microsoft.com → your project → Setup → tag id
NEXT_PUBLIC_CLARITY_ID=

# GA4 Measurement Protocol — server-side ingestion for the MOBILE APP.
# The website reports through gtag in the browser; the app can't, so it
# posts to /api/mobile/track and we forward to the same GA4 property.
# Create at: GA4 -> Admin -> Data Streams -> (your stream) ->
# Measurement Protocol API secrets -> Create.
# Server-only. Never expose with a NEXT_PUBLIC_ prefix — anyone holding
# it can write fake events into your property.
GA4_API_SECRET=
