# ----- Supabase (✅ project معدّ ومستعد) -----
NEXT_PUBLIC_SUPABASE_URL=https://jnxtcpicctcnmirjorje.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xH8JZ4L3WpNpIxnMyx4aog_Rt2nfzpd

# 🚨 الـ Service Role Key لازم تحصله من:
# https://supabase.com/dashboard/project/jnxtcpicctcnmirjorje/settings/api
# تحت "Project API keys" → "service_role" → "Reveal"
SUPABASE_SERVICE_ROLE_KEY=

# ----- Stripe -----
# سجل في stripe.com وخذ الـ keys من Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# لما تعمل Product → Prices في Stripe Dashboard، حط الـ IDs هنا
STRIPE_PRICE_ID_MONTHLY=                  # price_xxx (للـ $5/شهر)
STRIPE_PRICE_ID_YEARLY=                   # price_xxx (للـ $40/سنة)

# ----- Paymob (احتياطي - لو Stripe ما اشتغلش معاك) -----
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_WALLET=
PAYMOB_HMAC_SECRET=

# ----- Cloudflare R2 (للملفات والشهادات) -----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=faahm-assets
NEXT_PUBLIC_R2_PUBLIC_URL=https://assets.faahm.com

# ----- Resend (إيميلات الترحيب وإلخ) -----
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@faahm.com

# ----- App Config -----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_WHATSAPP=201XXXXXXXX
