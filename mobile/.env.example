# Copy to .env for local dev. In Codemagic these live in an encrypted
# environment group named `faahm_mobile` — never commit real values.
#
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time, which
# means they ship to the device. Only the ANON key belongs here; the
# service-role key must NEVER appear in this file or anywhere in mobile/.
EXPO_PUBLIC_SUPABASE_URL=https://jnxtcpicctcnmirjorje.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
EXPO_PUBLIC_API_BASE_URL=https://faahm.com
